# Always put comments at the start of a line.
# With `KEY= # description`, pasting the line as-is into the dashboard input
# saves ` # description` as part of the value.
# Until 2026-08-16 all 3 production variables were actually in that state, and the
# contact form kept failing silently.

# Required. If unset, a configuration error (設定エラー) is shown.
RESEND_API_KEY=

# Optional. If unset, the email in src/data/profile.ts is used.
RESEND_TO_EMAIL=

# Optional. If unset, "Resume Contact <onboarding@resend.dev>" is used.
# onboarding@resend.dev is Resend's test sender and only delivers to the account
# owner's address. To send to third parties, use a verified domain.
RESEND_FROM_EMAIL=
