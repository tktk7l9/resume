# コメントは必ず「行頭」に書くこと。
# `KEY= # 説明` の形にすると、この行をそのままダッシュボードの入力欄へ
# 貼り付けたときに ` # 説明` まで値の一部として保存されてしまう。
# 実際に 2026-08-16 まで本番の 3 変数すべてがこの状態で、問い合わせ
# フォームが無言で失敗し続けていた。

# 必須。未設定だと「設定エラー」が表示される。
RESEND_API_KEY=

# 任意。未設定なら src/data/profile.ts の email が使われる。
RESEND_TO_EMAIL=

# 任意。未設定なら "Resume Contact <onboarding@resend.dev>" が使われる。
# onboarding@resend.dev は Resend のテスト用送信元で、アカウント所有者の
# アドレス宛にしか届かない。第三者へ送る用途では verify 済みドメインにする。
RESEND_FROM_EMAIL=
