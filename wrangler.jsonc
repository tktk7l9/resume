/**
 * 職務経歴書 — Cloudflare Workers 設定
 * https://developers.cloudflare.com/workers/framework-guides/web-apps/nextjs/
 *
 * Next.js を @opennextjs/cloudflare でビルドして Workers で動かす。
 * /contact の Server Action (Resend でメール送信) があるため純粋な静的配信
 * にはできず、Worker スクリプト(main)が必要。
 *
 * RESEND_API_KEY / RESEND_TO_EMAIL / RESEND_FROM_EMAIL は wrangler secret
 * で設定する(この設定ファイルには書かない)。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  // Next.js の実行に必須。日付は 2024-09-23 以降であること。
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
