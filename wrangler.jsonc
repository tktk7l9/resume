/**
 * Résumé (職務経歴書) — Cloudflare Workers config
 * https://developers.cloudflare.com/workers/framework-guides/web-apps/nextjs/
 *
 * Next.js is built with @opennextjs/cloudflare and runs on Workers.
 * The /contact Server Action (sends mail via Resend) means it cannot be served as
 * purely prebuilt files, so a Worker script (main) is required.
 *
 * RESEND_API_KEY / RESEND_TO_EMAIL / RESEND_FROM_EMAIL are set with wrangler secret
 * (never written in this config file).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  // Required to run Next.js. The date must be 2024-09-23 or later.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
